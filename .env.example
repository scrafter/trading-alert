# Copy to .env and fill in. Each channel is enabled only when all its values are set;
# alerts are always printed to the console as well.

# WhatsApp via CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Phone in international format, e.g. +48123456789
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=

# Telegram: bot token from @BotFather, chat id of the chat to post to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
